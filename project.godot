GameManager="*res://Scripts/Economy/GameManager.cs"
AudioSettings="*res://Scripts/UI/AudioSettings.cs"
KeybindingsManager="*res://Scripts/UI/KeybindingsManager.cs"

[display]

window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="SupKonQuest"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

