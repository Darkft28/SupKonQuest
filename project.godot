;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SupKonQuest"
run/main_scene="uid://d2v1sgk2tlmyr"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameState="*res://Scripts/Network/GameState.cs"
